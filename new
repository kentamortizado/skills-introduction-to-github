//+------------------------------------------------------------------+
//|                                             TrendFollower_EA.mq5 |
//|  EMA crossover + ADX trend filter + ATR-based stops             |
//|  Fixed-percent risk sizing, daily loss limit, trailing stop      |
//|                                                                  |
//|  DEFAULTS TUNED FOR: EURUSD, H1 timeframe                        |
//|  ALWAYS BACKTEST AND DEMO-TRADE BEFORE GOING LIVE.               |
//+------------------------------------------------------------------+
#property copyright "Built for personal use"
#property version   "1.00"
#property strict
#property description "Trend-following EA: EMA cross, ADX filter, ATR stops, % risk sizing."

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\SymbolInfo.mqh>

//--- Strategy inputs
input group "=== Strategy ==="
input int      InpFastEMA        = 20;     // Fast EMA period
input int      InpSlowEMA        = 50;     // Slow EMA period
input int      InpADXPeriod      = 14;     // ADX period
input double   InpADXMin         = 25.0;   // Minimum ADX to allow a trade (trend strength)
input int      InpATRPeriod      = 14;     // ATR period
input double   InpSL_ATR         = 2.0;    // Stop loss  = ATR x this
input double   InpTP_ATR         = 3.0;    // Take profit = ATR x this
input bool     InpUseTrailing    = true;   // Enable ATR trailing stop
input double   InpTrail_ATR      = 1.5;    // Trailing distance = ATR x this

//--- Risk inputs
input group "=== Risk Management ==="
input double   InpRiskPercent    = 1.0;    // Risk per trade (% of balance)
input double   InpMaxDailyLossPct= 3.0;    // Stop trading for the day after this % loss
input int      InpMaxSpreadPts   = 30;     // Max allowed spread (points)
input int      InpMaxPositions   = 1;      // Max open positions for this EA
input double   InpMaxLot         = 1.0;    // Hard cap on lot size

//--- Filters
input group "=== Filters ==="
input bool     InpUseTimeFilter  = true;   // Only trade during set hours (server time)
input int      InpStartHour      = 7;      // Start hour (server time)
input int      InpEndHour        = 20;     // End hour (server time)
input bool     InpSkipFriday     = true;   // No new trades on Friday after 14:00

//--- Identification
input group "=== Identification ==="
input ulong    InpMagic          = 20260924; // Magic number
input string   InpComment        = "TrendEA"; // Order comment

//--- Globals
CTrade         trade;
CPositionInfo  posInfo;
CSymbolInfo    symInfo;

int      hFast = INVALID_HANDLE, hSlow = INVALID_HANDLE;
int      hADX  = INVALID_HANDLE, hATR  = INVALID_HANDLE;
datetime lastBarTime      = 0;
double   dayStartBalance  = 0.0;
int      trackedDay       = -1;
bool     haltedToday      = false;

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   if(InpFastEMA >= InpSlowEMA)
   {
      Print("ERROR: Fast EMA must be smaller than Slow EMA.");
      return INIT_PARAMETERS_INCORRECT;
   }
   if(InpRiskPercent <= 0 || InpRiskPercent > 5)
   {
      Print("ERROR: Risk % must be between 0 and 5.");
      return INIT_PARAMETERS_INCORRECT;
   }

   if(!symInfo.Name(_Symbol))
   {
      Print("ERROR: Symbol init failed.");
      return INIT_FAILED;
   }

   hFast = iMA(_Symbol, _Period, InpFastEMA, 0, MODE_EMA, PRICE_CLOSE);
   hSlow = iMA(_Symbol, _Period, InpSlowEMA, 0, MODE_EMA, PRICE_CLOSE);
   hADX  = iADX(_Symbol, _Period, InpADXPeriod);
   hATR  = iATR(_Symbol, _Period, InpATRPeriod);

   if(hFast == INVALID_HANDLE || hSlow == INVALID_HANDLE ||
      hADX  == INVALID_HANDLE || hATR  == INVALID_HANDLE)
   {
      Print("ERROR: Failed to create indicator handles.");
      return INIT_FAILED;
   }

   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(20);
   trade.SetTypeFillingBySymbol(_Symbol);
   trade.SetAsyncMode(false);

   ResetDailyTracking();

   Print("TrendFollower_EA initialised on ", _Symbol, " ", EnumToString(_Period));
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization                                          |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(hFast != INVALID_HANDLE) IndicatorRelease(hFast);
   if(hSlow != INVALID_HANDLE) IndicatorRelease(hSlow);
   if(hADX  != INVALID_HANDLE) IndicatorRelease(hADX);
   if(hATR  != INVALID_HANDLE) IndicatorRelease(hATR);
}

//+------------------------------------------------------------------+
//| Expert tick                                                      |
//+------------------------------------------------------------------+
void OnTick()
{
   if(!symInfo.RefreshRates()) return;

   UpdateDailyTracking();

   // Manage existing positions on every tick
   if(InpUseTrailing) ManageTrailingStops();

   // Only evaluate entries once per closed bar
   if(!IsNewBar()) return;

   if(haltedToday) return;
   if(!PassesFilters()) return;
   if(CountOwnPositions() >= InpMaxPositions) return;

   CheckForEntry();
}

//+------------------------------------------------------------------+
//| New bar detection                                                |
//+------------------------------------------------------------------+
bool IsNewBar()
{
   datetime t = iTime(_Symbol, _Period, 0);
   if(t != lastBarTime)
   {
      lastBarTime = t;
      return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| Daily loss limit tracking                                        |
//+------------------------------------------------------------------+
void ResetDailyTracking()
{
   MqlDateTime dt;
   TimeCurrent(dt);
   trackedDay      = dt.day_of_year;
   dayStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   haltedToday     = false;
}

void UpdateDailyTracking()
{
   MqlDateTime dt;
   TimeCurrent(dt);
   if(dt.day_of_year != trackedDay)
      ResetDailyTracking();

   if(!haltedToday && dayStartBalance > 0)
   {
      double equity   = AccountInfoDouble(ACCOUNT_EQUITY);
      double lossPct  = (dayStartBalance - equity) / dayStartBalance * 100.0;
      if(lossPct >= InpMaxDailyLossPct)
      {
         haltedToday = true;
         Print("Daily loss limit reached (", DoubleToString(lossPct, 2),
               "%). No new trades until tomorrow.");
      }
   }
}

//+------------------------------------------------------------------+
//| Time / spread filters                                            |
//+------------------------------------------------------------------+
bool PassesFilters()
{
   // Spread
   long spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   if(spread > InpMaxSpreadPts) return false;

   MqlDateTime dt;
   TimeCurrent(dt);

   // Trading hours
   if(InpUseTimeFilter)
   {
      if(InpStartHour <= InpEndHour)
      {
         if(dt.hour < InpStartHour || dt.hour >= InpEndHour) return false;
      }
      else // overnight window e.g. 22 -> 6
      {
         if(dt.hour < InpStartHour && dt.hour >= InpEndHour) return false;
      }
   }

   // Avoid late Friday (weekend gap risk)
   if(InpSkipFriday && dt.day_of_week == 5 && dt.hour >= 14) return false;

   // Market open check
   if(!SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE)) return false;

   return true;
}

//+------------------------------------------------------------------+
//| Count positions belonging to this EA on this symbol             |
//+------------------------------------------------------------------+
int CountOwnPositions()
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(posInfo.SelectByIndex(i))
      {
         if(posInfo.Symbol() == _Symbol && posInfo.Magic() == InpMagic)
            count++;
      }
   }
   return count;
}

//+------------------------------------------------------------------+
//| Read indicator buffers (index 1 = last closed bar)              |
//+------------------------------------------------------------------+
bool GetIndicators(double &fast1, double &fast2, double &slow1, double &slow2,
                   double &adx1, double &atr1)
{
   double f[], s[], a[], r[];
   ArraySetAsSeries(f, true);
   ArraySetAsSeries(s, true);
   ArraySetAsSeries(a, true);
   ArraySetAsSeries(r, true);

   if(CopyBuffer(hFast, 0, 0, 3, f) < 3) return false;
   if(CopyBuffer(hSlow, 0, 0, 3, s) < 3) return false;
   if(CopyBuffer(hADX,  0, 0, 3, a) < 3) return false;   // buffer 0 = main ADX line
   if(CopyBuffer(hATR,  0, 0, 3, r) < 3) return false;

   fast1 = f[1]; fast2 = f[2];
   slow1 = s[1]; slow2 = s[2];
   adx1  = a[1];
   atr1  = r[1];
   return true;
}

//+------------------------------------------------------------------+
//| Entry logic                                                      |
//+------------------------------------------------------------------+
void CheckForEntry()
{
   double fast1, fast2, slow1, slow2, adx1, atr1;
   if(!GetIndicators(fast1, fast2, slow1, slow2, adx1, atr1)) return;
   if(atr1 <= 0) return;

   bool trendStrong = (adx1 >= InpADXMin);
   bool crossUp     = (fast2 <= slow2 && fast1 > slow1);
   bool crossDown   = (fast2 >= slow2 && fast1 < slow1);

   if(!trendStrong) return;

   double slDist = NormalizeDouble(atr1 * InpSL_ATR, _Digits);
   double tpDist = NormalizeDouble(atr1 * InpTP_ATR, _Digits);

   // Respect broker minimum stop distance
   double minStop = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
   if(slDist < minStop) slDist = minStop;
   if(tpDist < minStop) tpDist = minStop;

   double lot = CalculateLot(slDist);
   if(lot <= 0) return;

   if(crossUp)
   {
      double ask = symInfo.Ask();
      double sl  = NormalizeDouble(ask - slDist, _Digits);
      double tp  = NormalizeDouble(ask + tpDist, _Digits);
      if(trade.Buy(lot, _Symbol, ask, sl, tp, InpComment))
         Print("BUY opened: lot=", lot, " SL=", sl, " TP=", tp, " ADX=", DoubleToString(adx1,1));
      else
         Print("BUY failed: ", trade.ResultRetcodeDescription());
   }
   else if(crossDown)
   {
      double bid = symInfo.Bid();
      double sl  = NormalizeDouble(bid + slDist, _Digits);
      double tp  = NormalizeDouble(bid - tpDist, _Digits);
      if(trade.Sell(lot, _Symbol, bid, sl, tp, InpComment))
         Print("SELL opened: lot=", lot, " SL=", sl, " TP=", tp, " ADX=", DoubleToString(adx1,1));
      else
         Print("SELL failed: ", trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
//| Position sizing: risk a fixed % of balance per trade            |
//+------------------------------------------------------------------+
double CalculateLot(double slDistancePrice)
{
   double balance   = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskMoney = balance * InpRiskPercent / 100.0;

   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickValue <= 0 || tickSize <= 0 || slDistancePrice <= 0) return 0;

   // Loss in account currency for 1.0 lot if SL is hit
   double lossPerLot = (slDistancePrice / tickSize) * tickValue;
   if(lossPerLot <= 0) return 0;

   double lot = riskMoney / lossPerLot;

   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   lot = MathFloor(lot / lotStep) * lotStep;
   if(lot > InpMaxLot) lot = InpMaxLot;
   if(lot > maxLot)    lot = maxLot;

   if(lot < minLot)
   {
      // Even the minimum lot exceeds our risk budget. Warn and skip.
      double minLotRisk = lossPerLot * minLot;
      if(minLotRisk > riskMoney * 1.5)
      {
         Print("Skipping trade: min lot ", minLot, " would risk ",
               DoubleToString(minLotRisk, 2), " (budget ", DoubleToString(riskMoney, 2), ")");
         return 0;
      }
      lot = minLot; // tolerate up to 1.5x budget on tiny accounts
   }

   // Margin check
   double marginNeeded = 0;
   if(OrderCalcMargin(ORDER_TYPE_BUY, _Symbol, lot, symInfo.Ask(), marginNeeded))
   {
      double freeMargin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
      if(marginNeeded > freeMargin * 0.8)
      {
         Print("Skipping trade: insufficient free margin.");
         return 0;
      }
   }

   return NormalizeDouble(lot, 2);
}

//+------------------------------------------------------------------+
//| ATR trailing stop                                                |
//+------------------------------------------------------------------+
void ManageTrailingStops()
{
   double atr[];
   ArraySetAsSeries(atr, true);
   if(CopyBuffer(hATR, 0, 0, 2, atr) < 2) return;
   double trailDist = atr[1] * InpTrail_ATR;
   if(trailDist <= 0) return;

   double minStop = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
   if(trailDist < minStop) trailDist = minStop;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagic) continue;

      double curSL = posInfo.StopLoss();
      double curTP = posInfo.TakeProfit();
      double open  = posInfo.PriceOpen();

      if(posInfo.PositionType() == POSITION_TYPE_BUY)
      {
         double bid   = symInfo.Bid();
         double newSL = NormalizeDouble(bid - trailDist, _Digits);
         // Only trail once in profit, and only move SL up
         if(bid > open && newSL > curSL + _Point && newSL < bid - minStop)
            trade.PositionModify(posInfo.Ticket(), newSL, curTP);
      }
      else if(posInfo.PositionType() == POSITION_TYPE_SELL)
      {
         double ask   = symInfo.Ask();
         double newSL = NormalizeDouble(ask + trailDist, _Digits);
         if(ask < open && (curSL == 0 || newSL < curSL - _Point) && newSL > ask + minStop)
            trade.PositionModify(posInfo.Ticket(), newSL, curTP);
      }
   }
}
