//+------------------------------------------------------------------+
//|                                               GoldScalper_EA.mq5 |
//|  Intraday scalper: EMA200 bias + EMA20 pullback + RSI confirm    |
//|  ATR stops, % risk sizing, daily trade cap, EOD flatten          |
//|                                                                  |
//|  DEFAULTS TUNED FOR: XAUUSD, M5 timeframe                         |
//|  BACKTEST + DEMO FIRST. Scalping fights the spread every trade.  |
//+------------------------------------------------------------------+
#property copyright "Built for personal use"
#property version   "1.00"
#property strict
#property description "Gold M5 scalper: trend-pullback entries, ATR stops, day-trader rules."

#include <Trade\Trade.mqh>
#include <Trade\PositionInfo.mqh>
#include <Trade\SymbolInfo.mqh>

//--- Strategy
input group "=== Strategy ==="
input int      InpBiasEMA        = 200;    // Trend bias EMA
input int      InpPullbackEMA    = 20;     // Pullback EMA
input int      InpRSIPeriod      = 14;     // RSI period
input double   InpRSILongMin     = 50.0;   // RSI must be above this for longs
input double   InpRSIShortMax    = 50.0;   // RSI must be below this for shorts
input int      InpATRPeriod      = 14;     // ATR period
input double   InpSL_ATR         = 1.5;    // Stop loss  = ATR x this
input double   InpTP_ATR         = 1.5;    // Take profit = ATR x this
input bool     InpUseBreakEven   = true;   // Move SL to entry after gaining X ATR
input double   InpBE_ATR         = 0.8;    // Break-even trigger (ATR multiple)
input int      InpMaxHoldBars    = 24;     // Close trade after N bars if still open (0 = off)

//--- Risk
input group "=== Risk Management ==="
input double   InpRiskPercent    = 1.0;    // Target risk per trade (% of balance)
input double   InpMaxRiskPctMinLot = 3.0;  // Hard ceiling if min lot exceeds target (%)
input double   InpMaxSpreadPctTP = 25.0;   // Max spread as % of take-profit distance
input double   InpMaxDailyLossPct= 4.0;    // Stop trading for the day after this % loss
input int      InpMaxTradesPerDay= 6;      // Max new trades per day
input int      InpMaxConsecLoss  = 3;      // Stop for the day after N losses in a row
input int      InpMaxPositions   = 1;      // Max open positions
input double   InpMaxLot         = 0.5;    // Hard lot cap

//--- Day-trading rules
input group "=== Session (server time) ==="
input int      InpStartHour      = 8;      // First entry hour (London open ~8-9)
input int      InpEndHour        = 20;     // Last entry hour
input int      InpFlattenHour    = 22;     // Close ALL positions at this hour
input bool     InpSkipFridayLate = true;   // No entries Friday after 15:00

//--- Misc
input group "=== Misc ==="
input ulong    InpMagic          = 20260925;
input string   InpComment        = "GoldScalp";
input bool     InpDebug          = true;   // Log block reasons (turn off live)
input bool     InpForceTestTrade = false;  // TESTER ONLY: open 1 min-lot trade on first bar to prove pipeline

//--- Globals
CTrade         trade;
CPositionInfo  posInfo;
CSymbolInfo    symInfo;

int hBias = INVALID_HANDLE, hPull = INVALID_HANDLE, hRSI = INVALID_HANDLE, hATR = INVALID_HANDLE;
datetime lastBarTime = 0;
int      trackedDay = -1;
double   dayStartBalance = 0;
int      tradesToday = 0;
int      consecLosses = 0;
bool     haltedToday = false;
bool     flattenedToday = false;
bool     smokeTestDone = false;
int      barsSeen = 0;

//+------------------------------------------------------------------+
int OnInit()
{
   if(!symInfo.Name(_Symbol)) return INIT_FAILED;

   hBias = iMA(_Symbol, _Period, InpBiasEMA, 0, MODE_EMA, PRICE_CLOSE);
   hPull = iMA(_Symbol, _Period, InpPullbackEMA, 0, MODE_EMA, PRICE_CLOSE);
   hRSI  = iRSI(_Symbol, _Period, InpRSIPeriod, PRICE_CLOSE);
   hATR  = iATR(_Symbol, _Period, InpATRPeriod);
   if(hBias == INVALID_HANDLE || hPull == INVALID_HANDLE || hRSI == INVALID_HANDLE || hATR == INVALID_HANDLE)
   {
      Print("ERROR: indicator handle failed");
      return INIT_FAILED;
   }

   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(30);
   trade.SetTypeFillingBySymbol(_Symbol);

   ResetDay();
   Print("GoldScalper_EA v1.00 initialised on ", _Symbol, " ", EnumToString(_Period),
         " | digits=", _Digits, " point=", DoubleToString(_Point, _Digits),
         " minLot=", SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN),
         " tickValue=", SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE),
         " tester=", (MQLInfoInteger(MQL_TESTER) ? "yes" : "no"));
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   if(hBias != INVALID_HANDLE) IndicatorRelease(hBias);
   if(hPull != INVALID_HANDLE) IndicatorRelease(hPull);
   if(hRSI  != INVALID_HANDLE) IndicatorRelease(hRSI);
   if(hATR  != INVALID_HANDLE) IndicatorRelease(hATR);
}

//+------------------------------------------------------------------+
void OnTick()
{
   if(!symInfo.RefreshRates()) return;
   UpdateDay();

   ManageOpenPositions();   // every tick: break-even, time exit, EOD flatten

   if(!IsNewBar()) return;
   barsSeen++;

   if(barsSeen == 1) Print("First bar processed at ", TimeToString(TimeCurrent()), " - data is flowing.");

   // ---- Smoke test: proves orders can be placed in this tester setup ----
   if(InpForceTestTrade && MQLInfoInteger(MQL_TESTER) && !smokeTestDone && barsSeen >= 2)
   {
      smokeTestDone = true;
      double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      double ask = symInfo.Ask();
      double dist = 300 * _Point * (_Digits == 3 || _Digits == 5 ? 10 : 1);
      if(trade.Buy(minLot, _Symbol, ask, NormalizeDouble(ask - dist, _Digits), NormalizeDouble(ask + dist, _Digits), "SMOKETEST"))
         Print("SMOKE TEST: order placed OK. Pipeline works. Disable InpForceTestTrade now.");
      else
         Print("SMOKE TEST FAILED: ", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription());
      return;
   }

   if(haltedToday) return;
   if(!SessionOK()) return;
   if(tradesToday >= InpMaxTradesPerDay) { Dbg("Blocked: daily trade cap"); return; }
   if(CountOwn() >= InpMaxPositions) return;

   CheckEntry();
}

//+------------------------------------------------------------------+
void Dbg(string m) { if(InpDebug) Print("[", TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES), "] ", m); }

bool IsNewBar()
{
   datetime t = iTime(_Symbol, _Period, 0);
   if(t != lastBarTime) { lastBarTime = t; return true; }
   return false;
}

//+------------------------------------------------------------------+
void ResetDay()
{
   MqlDateTime dt; TimeCurrent(dt);
   trackedDay = dt.day_of_year;
   dayStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   tradesToday = 0; consecLosses = 0;
   haltedToday = false; flattenedToday = false;
}

void UpdateDay()
{
   MqlDateTime dt; TimeCurrent(dt);
   if(dt.day_of_year != trackedDay) ResetDay();

   if(!haltedToday && dayStartBalance > 0)
   {
      double lossPct = (dayStartBalance - AccountInfoDouble(ACCOUNT_EQUITY)) / dayStartBalance * 100.0;
      if(lossPct >= InpMaxDailyLossPct)
      {
         haltedToday = true;
         Print("Daily loss limit hit (", DoubleToString(lossPct,2), "%). Done for today.");
      }
   }
}

//+------------------------------------------------------------------+
bool SessionOK()
{
   MqlDateTime dt; TimeCurrent(dt);
   if(dt.hour < InpStartHour || dt.hour >= InpEndHour) return false;   // quiet: happens most of the day
   if(InpSkipFridayLate && dt.day_of_week == 5 && dt.hour >= 15) { Dbg("Blocked: Friday late"); return false; }
   if(SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE) == SYMBOL_TRADE_MODE_DISABLED) { Dbg("Blocked: symbol trading disabled"); return false; }
   return true;
}

int CountOwn()
{
   int n = 0;
   for(int i = PositionsTotal()-1; i >= 0; i--)
      if(posInfo.SelectByIndex(i) && posInfo.Symbol() == _Symbol && posInfo.Magic() == InpMagic) n++;
   return n;
}

//+------------------------------------------------------------------+
bool GetData(double &bias1, double &pull1, double &pull2, double &c1, double &c2, double &rsi1, double &atr1)
{
   double b[], p[], r[], a[];
   ArraySetAsSeries(b,true); ArraySetAsSeries(p,true); ArraySetAsSeries(r,true); ArraySetAsSeries(a,true);
   if(CopyBuffer(hBias,0,0,3,b) < 3) return false;
   if(CopyBuffer(hPull,0,0,3,p) < 3) return false;
   if(CopyBuffer(hRSI ,0,0,3,r) < 3) return false;
   if(CopyBuffer(hATR ,0,0,3,a) < 3) return false;
   bias1 = b[1]; pull1 = p[1]; pull2 = p[2];
   c1 = iClose(_Symbol,_Period,1); c2 = iClose(_Symbol,_Period,2);
   rsi1 = r[1]; atr1 = a[1];
   return true;
}

//+------------------------------------------------------------------+
void CheckEntry()
{
   double bias1, pull1, pull2, c1, c2, rsi1, atr1;
   if(!GetData(bias1,pull1,pull2,c1,c2,rsi1,atr1)) { Dbg("Blocked: indicator data not ready"); return; }
   if(atr1 <= 0) return;

   // Long: uptrend (close above EMA200), price dipped below EMA20 last bar and closed back above it
   bool longSetup  = (c1 > bias1) && (c2 < pull2) && (c1 > pull1) && (rsi1 > InpRSILongMin);
   // Short: mirror
   bool shortSetup = (c1 < bias1) && (c2 > pull2) && (c1 < pull1) && (rsi1 < InpRSIShortMax);

   if(!longSetup && !shortSetup) return;

   double slDist = NormalizeDouble(atr1 * InpSL_ATR, _Digits);
   double tpDist = NormalizeDouble(atr1 * InpTP_ATR, _Digits);
   double minStop = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
   if(slDist < minStop) slDist = minStop;
   if(tpDist < minStop) tpDist = minStop;

   double spread = symInfo.Ask() - symInfo.Bid();
   double spreadPct = spread / tpDist * 100.0;
   Dbg((longSetup ? "LONG" : "SHORT") + " setup. RSI=" + DoubleToString(rsi1,1) +
       " ATR=" + DoubleToString(atr1,_Digits) + " spread=" + DoubleToString(spreadPct,1) + "% of TP");
   if(spreadPct > InpMaxSpreadPctTP) { Dbg("Blocked: spread too wide vs target"); return; }

   double lot = CalcLot(slDist);
   if(lot <= 0) return;

   bool ok;
   if(longSetup)
   {
      double ask = symInfo.Ask();
      ok = trade.Buy(lot, _Symbol, ask, NormalizeDouble(ask - slDist,_Digits), NormalizeDouble(ask + tpDist,_Digits), InpComment);
   }
   else
   {
      double bid = symInfo.Bid();
      ok = trade.Sell(lot, _Symbol, bid, NormalizeDouble(bid + slDist,_Digits), NormalizeDouble(bid - tpDist,_Digits), InpComment);
   }
   if(ok) { tradesToday++; Print("Trade opened: lot=", lot, " (", tradesToday, "/", InpMaxTradesPerDay, " today)"); }
   else   Print("Order failed: ", trade.ResultRetcodeDescription());
}

//+------------------------------------------------------------------+
double CalcLot(double slDist)
{
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskMoney = balance * InpRiskPercent / 100.0;
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickValue <= 0 || tickSize <= 0 || slDist <= 0) return 0;

   double lossPerLot = slDist / tickSize * tickValue;
   double lot = riskMoney / lossPerLot;

   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double step   = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   lot = MathFloor(lot / step) * step;
   lot = MathMin(lot, MathMin(InpMaxLot, maxLot));

   if(lot < minLot)
   {
      double pct = lossPerLot * minLot / balance * 100.0;
      if(pct > InpMaxRiskPctMinLot)
      {
         Print("Skipping: min lot risks ", DoubleToString(pct,1), "% > ceiling ", DoubleToString(InpMaxRiskPctMinLot,1), "%");
         return 0;
      }
      Dbg("Using min lot, actual risk " + DoubleToString(pct,1) + "%");
      lot = minLot;
   }

   double margin = 0;
   if(OrderCalcMargin(ORDER_TYPE_BUY, _Symbol, lot, symInfo.Ask(), margin) &&
      margin > AccountInfoDouble(ACCOUNT_MARGIN_FREE) * 0.8)
   {
      Print("Skipping: insufficient margin");
      return 0;
   }
   return NormalizeDouble(lot, 2);
}

//+------------------------------------------------------------------+
void ManageOpenPositions()
{
   MqlDateTime dt; TimeCurrent(dt);
   bool flattenNow = (dt.hour >= InpFlattenHour);

   double atr[]; ArraySetAsSeries(atr,true);
   bool haveATR = (CopyBuffer(hATR,0,0,2,atr) >= 2);
   double minStop = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;

   for(int i = PositionsTotal()-1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagic) continue;

      ulong ticket = posInfo.Ticket();

      // 1. End-of-day flatten
      if(flattenNow)
      {
         if(trade.PositionClose(ticket)) Print("EOD flatten: closed #", ticket);
         continue;
      }

      // 2. Time-based exit
      if(InpMaxHoldBars > 0)
      {
         int barsOpen = iBarShift(_Symbol, _Period, posInfo.Time());
         if(barsOpen >= InpMaxHoldBars)
         {
            if(trade.PositionClose(ticket)) Print("Time exit: closed #", ticket, " after ", barsOpen, " bars");
            continue;
         }
      }

      // 3. Break-even
      if(InpUseBreakEven && haveATR)
      {
         double open = posInfo.PriceOpen(), sl = posInfo.StopLoss(), tp = posInfo.TakeProfit();
         double trigger = atr[1] * InpBE_ATR;
         if(posInfo.PositionType() == POSITION_TYPE_BUY)
         {
            double bid = symInfo.Bid();
            double be = NormalizeDouble(open + 2*_Point, _Digits);
            if(bid - open >= trigger && sl < open && bid - be > minStop)
               trade.PositionModify(ticket, be, tp);
         }
         else
         {
            double ask = symInfo.Ask();
            double be = NormalizeDouble(open - 2*_Point, _Digits);
            if(open - ask >= trigger && (sl == 0 || sl > open) && be - ask > minStop)
               trade.PositionModify(ticket, be, tp);
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Track consecutive losses from closed deals                       |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &req, const MqlTradeResult &res)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD) return;
   if(!HistoryDealSelect(trans.deal)) return;
   if(HistoryDealGetInteger(trans.deal, DEAL_MAGIC) != (long)InpMagic) return;
   if(HistoryDealGetInteger(trans.deal, DEAL_ENTRY) != DEAL_ENTRY_OUT) return;

   double profit = HistoryDealGetDouble(trans.deal, DEAL_PROFIT) +
                   HistoryDealGetDouble(trans.deal, DEAL_SWAP) +
                   HistoryDealGetDouble(trans.deal, DEAL_COMMISSION);
   if(profit < 0)
   {
      consecLosses++;
      if(consecLosses >= InpMaxConsecLoss && !haltedToday)
      {
         haltedToday = true;
         Print(consecLosses, " losses in a row. Done for today.");
      }
   }
   else consecLosses = 0;
}
